#!/usr/bin/env bash
PID_FILE="/var/run/myscript.pid"

cleanup_and_exit() {
    rm -f "$PID_FILE"
    exit 0
}

handle_sigint() {
    echo "Y U no love me?!"
}

handle_sigterm() {
    echo "I hate the kill command"
    cleanup_and_exit
}

handle_sigquit() {
    cleanup_and_exit
}

trap handle_sigint SIGINT
trap handle_sigterm SIGTERM
trap handle_sigquit SIGQUIT

echo $$ > "$PID_FILE"

while true; do
    echo "To infinity and beyond"
    sleep 1
done
